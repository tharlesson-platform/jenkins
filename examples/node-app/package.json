{
  "name": "node-app",
  "version": "1.0.0",
  "description": "Minimal Node sample for Jenkins CI validation",
  "main": "src/index.js",
  "scripts": {
    "lint": "node --check src/index.js && node --check src/sum.js",
    "test": "mkdir -p test-results coverage && node --test --experimental-test-coverage --test-reporter=spec --test-reporter=junit --test-reporter=lcov --test-reporter-destination=stdout --test-reporter-destination=test-results/junit.xml --test-reporter-destination=coverage/lcov.info test/*.test.js",
    "coverage": "npm test",
    "build": "mkdir -p dist && cp -r src/* dist/"
  },
  "engines": {
    "node": ">=22"
  }
}
